# Linera GraphQL Endpoint
VITE_GRAPHQL_ENDPOINT=http://127.0.0.1:8080/graphql

# WalletConnect Configuration
# Get your project ID from https://cloud.walletconnect.com/
VITE_WALLET_CONNECT_PROJECT_ID=

# WalletConnect Namespace (optional)
# Use "linera" for Linera-compatible wallets, or configure a custom namespace
# Falls back to "eip155" if not set (may require EVM signer)
VITE_WC_NAMESPACE=linera
